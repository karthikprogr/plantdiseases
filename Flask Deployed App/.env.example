# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-generate-a-strong-random-key
JWT_SECRET_KEY=your-jwt-secret-key-here-generate-another-strong-key

# Firebase Configuration
# Option 1: Path to service account JSON file (for local development)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Option 2: JSON string of service account (for production - Render.com)
# Paste the entire contents of your firebase service account JSON file
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}

# OpenAI Configuration (for AI-powered disease information)
OPENAI_API_KEY=your-openai-api-key-here

# Email Configuration (for password reset)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password

# Google OAuth (if using)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS Configuration
# For development
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# For production (add your Vercel domain after deployment)
# CORS_ORIGINS=https://your-app.vercel.app,https://your-backend.onrender.com

# Application Settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=static/uploads

# Instructions:
# 1. Copy this file to .env
# 2. Replace the values with your actual credentials
# 3. Never commit .env file to Git (it's in .gitignore)
# 4. For Render.com deployment, paste Firebase JSON as FIREBASE_CREDENTIALS
