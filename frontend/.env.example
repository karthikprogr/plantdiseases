# Frontend Environment Variables for Development
# Copy this file to .env.local and fill in your values

# Backend API URL
REACT_APP_API_URL=http://localhost:5000

# Firebase Configuration
# Get these from Firebase Console > Project Settings > Your apps > Web app
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789012
REACT_APP_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional: Google Analytics
# REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Instructions:
# 1. Copy this file: cp .env.example .env.local
# 2. Replace placeholder values with your actual Firebase credentials
# 3. .env.local is in .gitignore and won't be committed
# 4. For production (Vercel), set these as environment variables in dashboard
