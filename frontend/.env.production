# Production Environment Variables for Vercel Deployment
# These will be automatically used when building for production

# Backend API URL (Replace with your Render.com URL after backend deployment)
REACT_APP_API_URL=https://your-backend-app.onrender.com

# Firebase Configuration (same as development)
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789012
REACT_APP_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Note: When deploying to Vercel:
# 1. Go to Project Settings > Environment Variables
# 2. Add each variable above
# 3. Select "Production" environment
# 4. Redeploy after adding variables
